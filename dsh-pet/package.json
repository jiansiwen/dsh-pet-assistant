{
  "name": "dsh-pet",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness desktop pet: a cute assistant that tracks your day and writes your daily report",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test --experimental-test-module-mocks \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.1-rc.2",
    "sherpa-onnx-node": "^1.13.7",
    "sherpa-onnx-win-x64": "^1.13.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "electron": "^37.0.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "koffi",
      "protobufjs",
      "@deepseek-ai/dsh-subprocess-local"
    ]
  }
}
