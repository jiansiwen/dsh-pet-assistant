{
  "name": "dsh-personal-assistant",
  "version": "0.1.0",
  "description": "Personal computer assistant plugin for DeepSeek Harness: tracks daily computer activity, answers what the user did today, and generates daily reports with long-term preference memory",
  "type": "module",
  "main": "dist/index-1029163301.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "cordis.team.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"const fs=require('fs'),p=require('./package.json');const keep=p.main;for(const f of fs.readdirSync('dist')){if(f.endsWith('.js')&&'dist/'+f!==keep){try{fs.renameSync('dist/'+f,'dist/'+f+'.stale');console.log('archived',f)}catch(e){console.log('skip',f,e.code)}}}\"",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test --disable-warning=ExperimentalWarning \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.27.7",
    "typescript": "^5.6.0",
    "zod": "4.4.3"
  },
  "exports": {
    ".": "./dist/index-1029163301.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "1.0.7",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "10.2.1"
  }
}
